{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/primelogicsol/environmental-data-models/schemas/json/monitoring-event.schema.json",
  "title": "Monitoring Event",
  "description": "Demo schema for an environmental monitoring observation, sampling event, sensor reading, or field measurement.",
  "type": "object",
  "required": ["event_id", "facility_id", "observed_at", "medium", "parameters"],
  "properties": {
    "event_id": { "type": "string" },
    "facility_id": { "type": "string" },
    "monitoring_location_id": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "medium": {
      "type": "string",
      "enum": ["surface_water", "groundwater", "drinking_water", "wastewater", "air", "soil", "sediment", "solid_waste", "noise", "other"]
    },
    "collection_method": {
      "type": "string",
      "enum": ["manual_sample", "field_meter", "sensor", "lab_analysis", "remote_sensing", "inspection_observation", "other"]
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["parameter_name", "value", "unit"],
        "properties": {
          "parameter_name": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "method": { "type": "string" },
          "detection_limit": { "type": "number" },
          "quality_flag": { "type": "string", "enum": ["valid", "estimated", "rejected", "pending_review", "below_detection_limit"] },
          "threshold": {
            "type": "object",
            "properties": {
              "limit": { "type": "number" },
              "unit": { "type": "string" },
              "comparison": { "type": "string", "enum": ["less_than", "less_than_or_equal", "greater_than", "greater_than_or_equal", "range"] },
              "exceeded": { "type": "boolean" }
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "description": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "submitted_by": { "type": "string" },
        "review_status": { "type": "string", "enum": ["draft", "submitted", "reviewed", "approved", "rejected"] },
        "source_system": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
